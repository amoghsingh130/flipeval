Bootstrap: docker
From: python:3.11.14-slim-bookworm

%labels
    Author Amogh Singh
    Description FlipEval PACE runtime

%environment
    export PYTHONDONTWRITEBYTECODE=1
    export PYTHONUNBUFFERED=1
    export HF_HOME=/scratch/$USER/hf_cache

%files
    . /workspace

%post
    apt-get update
    apt-get install -y --no-install-recommends build-essential git ninja-build
    rm -rf /var/lib/apt/lists/*
    cd /workspace
    python -m pip install --upgrade pip setuptools wheel
    python -m pip install -r container/requirements.lock
    python -m pip install --no-deps .
    python -m pytest -q
    mkdir -p /opt/flipeval /kaggle/working/results
    python -m pip freeze > /opt/flipeval/environment.lock.txt

%runscript
    cd /workspace
    exec python "$@"

%test
    cd /workspace
    python -m pytest -q
